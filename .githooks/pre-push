#!/usr/bin/env sh
# Only main leaves this machine.
#
# The public repository is meant to hold one branch. Everything else here —
# dev, and the feat/ and fix/ branches that feed it — is work in progress,
# and work in progress is where real service names, cluster addresses and
# test credentials turn up before anybody has looked at them. The content
# gate on commit is the first line; this is the second, and it is the one
# that does not depend on the gate's patterns being complete.
#
# Enable with: git config core.hooksPath .githooks  (or `make hooks`)
#
# To push something else on purpose, say so out loud:
#   ALLOW_PUSH=1 git push origin <ref>

# stdin (the list of refs being pushed) can be read once and two loops need it.
refs="$(mktemp)"
# shellcheck disable=SC2064
trap "rm -f '$refs'" EXIT INT TERM
cat > "$refs"

while read -r local_ref _local_sha remote_ref _remote_sha; do
	# Deleting a remote ref arrives with a null local ref; let it through,
	# it publishes nothing.
	case "$local_ref" in
		'' | '(delete)') continue ;;
	esac

	case "$remote_ref" in
		refs/heads/main | refs/tags/*) continue ;;
	esac

	if [ -n "$ALLOW_PUSH" ]; then
		continue
	fi

	printf '✗ 只有 main 和 tag 能推到线上\n\n' >&2
	printf '    被拒绝的:  %s -> %s\n\n' "$local_ref" "$remote_ref" >&2
	printf '  发版流程是 feat/fix 合到 dev，发布时 dev 合 main，推 main 再打 tag。\n' >&2
	printf '  确实要推别的，写明白：ALLOW_PUSH=1 git push ...\n' >&2
	exit 1
done < "$refs"

# core.hooksPath=.githooks replaces the machine-wide hooks outright, so their
# pre-push never ran here: commit-msg calls into them, this file did not. What
# was missing is the author check — a commit signed with the wrong identity is
# not in any message or file, so nothing below would notice it.
# Machine-wide checks, wherever this machine keeps them (make hooks-check).
g=$(git config --get hooks.global || true)
[ -n "$g" ] || echo "提示：没设 hooks.global，跳过全局检查" >&2
if [ -f "$g/leakcheck.py" ] && [ -f "$g/identity.py" ]; then
	while read -r _local_ref local_sha _remote_ref remote_sha; do
		case "$local_sha" in
			*[!0]*) ;;
			*) continue ;;
		esac
		case "$remote_sha" in
			*[!0]*) range="$remote_sha..$local_sha" ;;
			*) range="$local_sha" ;;
		esac
		python3 "$g/leakcheck.py" --outgoing "$range" || exit 1
		python3 "$g/identity.py" --range "$range" || exit 1
	done < "$refs"
fi

# Branch names are only half of it. Content that got committed before a rule
# existed to catch it is still sitting in history, and history is what a push
# publishes — so the last thing before the remote sees anything is a full
# sweep of the tracked files and of every message that is about to leave.
hack/check-no-internal-data.sh || exit 1
hack/check-no-internal-data.sh --messages || exit 1

# The sweep above sees the tree as it is now. History is published too: a
# name added in one commit and removed in a later one is not in the tree and
# is still in what leaves. So every commit about to go out is read one by
# one, and so is the message of every annotated tag.
while read -r local_ref local_sha _remote_ref remote_sha; do
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac
	if [ "$(git cat-file -t "$local_sha" 2>/dev/null)" = tag ]; then
		git cat-file -p "$local_sha" | sed '1,/^$/d' > "$refs.tag"
		hack/check-no-internal-data.sh --message "$refs.tag" || { rm -f "$refs.tag"; exit 1; }
		rm -f "$refs.tag"
	fi
	case "$remote_sha" in
		*[!0]*) range="$remote_sha..$local_sha" ;;
		# A new ref: what the remote has not seen yet.
		*) base=$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null) || base=""
		   [ -n "$base" ] || continue
		   range="$base..$local_sha" ;;
	esac
	[ -n "$(git rev-list "$range" 2>/dev/null | head -1)" ] || continue
	hack/check-no-internal-data.sh --range "$range" || exit 1
done < "$refs"

exit 0
